<% content_for :title, t('contact.meta.title') %>
<% content_for :description, t('contact.meta.description') %>

<section class="py-24 bg-gray-900">
  <div class="container mx-auto px-6 max-w-5xl">
    <h2 class="text-4xl font-bold orbitron-font mb-12 text-center text-white"><%= t('contact.title') %></h2>
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
      <!-- Info and B2B Booking Channels -->
      <div class="lg:col-span-5 space-y-8">
        <!-- Direct Contact Details -->
        <div class="bg-gray-800/40 border border-white/5 rounded-2xl p-6 shadow-lg backdrop-blur-md">
          <h3 class="text-xl font-bold text-white mb-6 orbitron-font flex items-center gap-2">
            <i class="mdi mdi-contacts-outline text-teal-400"></i>
            <%= t('contact.get_in_touch') %>
          </h3>
          
          <div class="space-y-5">
            <div class="flex items-start gap-3">
              <i class="mdi mdi-map-marker text-teal-400 text-xl mt-1"></i>
              <div>
                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest"><%= t('contact.location.label') %></p>
                <p class="text-gray-300 text-sm leading-relaxed"><%= t('contact.location.value') %></p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <i class="mdi mdi-phone text-teal-400 text-xl mt-1"></i>
              <div>
                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest"><%= t('contact.phone.label') %></p>
                <p class="text-gray-300 text-sm leading-relaxed"><%= t('contact.phone.value') %></p>
              </div>
            </div>
            
            <div class="flex items-start gap-3">
              <i class="mdi mdi-clock-outline text-teal-400 text-xl mt-1"></i>
              <div>
                <p class="text-xs text-gray-500 font-bold uppercase tracking-widest">Standard Response</p>
                <p class="text-gray-300 text-sm leading-relaxed"><%= t('contact.response_time.value') %></p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="flex items-center gap-4 mt-6 pt-6 border-t border-white/5">
            <a href="https://www.linkedin.com/in/nm85/" target="_blank" class="w-10 h-10 bg-gray-900 rounded-full flex items-center justify-center text-gray-400 hover:text-teal-400 hover:bg-teal-500/10 border border-white/5 transition-all duration-300">
              <i class="mdi mdi-linkedin text-xl"></i>
            </a>
            <a href="https://github.com/nicolasmd1985" target="_blank" class="w-10 h-10 bg-gray-900 rounded-full flex items-center justify-center text-gray-400 hover:text-teal-400 hover:bg-teal-500/10 border border-white/5 transition-all duration-300">
              <i class="mdi mdi-github text-xl"></i>
            </a>
          </div>
        </div>

        <!-- B2B Conversion Channels -->
        <div id="calendly" class="bg-gray-800/40 border border-white/5 rounded-2xl p-6 shadow-lg backdrop-blur-md relative overflow-hidden group">
          <div class="absolute -inset-px bg-gradient-to-r from-teal-500/10 to-indigo-500/10 rounded-2xl blur opacity-25 group-hover:opacity-40 transition duration-500"></div>
          <div class="relative z-10">
            <h3 class="text-xl font-bold text-white mb-4 orbitron-font flex items-center gap-2">
              <i class="mdi mdi-calendar-clock text-teal-400"></i>
              <%= t('contact.b2b_channels.title') %>
            </h3>
            
            <div class="space-y-6">
              <!-- Calendly block -->
              <div class="border-b border-white/5 pb-5">
                <p class="text-gray-400 text-xs leading-relaxed mb-3">
                  <%= t('contact.b2b_channels.calendly_desc') %>
                </p>
                <a href="https://calendly.com/nicolasmahecha" target="_blank" class="btn-primary py-2 px-4 text-xs inline-flex items-center gap-1.5 w-full justify-center">
                  <i class="mdi mdi-calendar-check text-base"></i>
                  <span><%= t('contact.b2b_channels.calendly_btn') %></span>
                </a>
              </div>

              <!-- WhatsApp block -->
              <div>
                <p class="text-gray-400 text-xs leading-relaxed mb-3">
                  <%= t('contact.b2b_channels.whatsapp_desc') %>
                </p>
                <a href="https://wa.me/19043850725" target="_blank" class="btn-secondary py-2 px-4 text-xs inline-flex items-center gap-1.5 w-full justify-center !border-emerald-500 !text-emerald-400 hover:bg-emerald-500/10">
                  <i class="mdi mdi-whatsapp text-base"></i>
                  <span><%= t('contact.b2b_channels.whatsapp_btn') %></span>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Secure Contact Form -->
      <div class="lg:col-span-7">
        <div class="bg-gray-800/40 border border-white/5 rounded-2xl p-8 shadow-lg backdrop-blur-md">
          <h3 class="text-xl font-bold text-white mb-6 orbitron-font flex items-center gap-2">
            <i class="mdi mdi-shield-key-outline text-teal-400"></i>
            <%= t('contact.send_message') %>
          </h3>
          <%= render "contact_form", contact: @contact %>
        </div>
      </div>
    </div>
  </div>
</section>
